NEXT_PUBLIC_DEMO=1
NEXT_PUBLIC_CHAIN=bscTestnet
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_RPC_URL=https://bsc-testnet.publicnode.com
NEXT_PUBLIC_CONTRACT_ADDRESS=0xc6Dd26D3eE0F58fAb15Dc87bEe3A66896B6D4127

# Paymaster Provider: pimlico | particle
NEXT_PUBLIC_PAYMASTER_PROVIDER=pimlico

# Pimlico Paymaster (Default for Testnet)
NEXT_PUBLIC_PAYMASTER_URL=https://api.pimlico.io/v2/97/rpc?apikey=YOUR_API_KEY
PIMLICO_API_KEY=YOUR_API_KEY

# Particle Paymaster (Optional - for Mainnet/Social Login)
NEXT_PUBLIC_PARTICLE_PAYMASTER_URL=
NEXT_PUBLIC_PARTICLE_API_KEY=